#!/bin/bash
#PBS -P ob80
#PBS -q normal
#PBS -N plassembler
#PBS -l walltime=12:00:00
#PBS -l ncpus=16
#PBS -l mem=64GB
#PBS -l jobfs=100GB
#PBS -l wd
#PBS -l storage=gdata/ob80+scratch/ob80
#PBS -j oe

# Assemble plasmids from nanopore reads with plassembler
# https://github.com/gbouras13/plassembler
#
# Use this instead of autocycler_run.pbs when the sample is a plasmid prep
# rather than a whole bacterial isolate. For a whole isolate it is still useful
# as a second look at the small plasmids, which long-read assemblers often
# miss or duplicate.
#
#   qsub -o logs/barcode16_plassembler.log -v READS=barcode16.fastq.gz,OUTDIR=barcode16_plassembler,CHROMOSOME=none plassembler_run.pbs
#
# READS       nanopore reads
# OUTDIR      output directory; results are in OUTDIR/plassembler_out
# CHROMOSOME  approximate lower bound for the chromosome length in bp (default
#             1000000, the plassembler default), or "none" when the reads are
#             plasmid only, which runs plassembler with --no_chromosome
#
# Optional variables:
#   CONDA_ENVS  where conda environments live (default /g/data/$PROJECT/$USER/conda)
#
# The same arguments can be given positionally when running the script with bash.

set -euo pipefail
trap 's=$?; echo "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR

reads=${READS:-${1:-}}
output=${OUTDIR:-${2:-}}
chromosome=${CHROMOSOME:-${3:-1000000}}

if [[ -z "$reads" || -z "$output" ]]; then
	echo "qsub -v READS=<nanopore reads>,OUTDIR=<output directory>[,CHROMOSOME=<length>|none] $0" >&2
	echo >&2
	echo "  CHROMOSOME length: approximate lower bound for the chromosome, in bp" >&2
	echo "                     (default 1000000, the plassembler default)" >&2
	echo "  CHROMOSOME=none:   the reads are plasmid only and no chromosome should" >&2
	echo "                     be expected, so run with --no_chromosome" >&2
	exit 2
fi

if [[ ! -f "$reads" ]]; then
	echo "Error: Input file '$reads' does not exist." >&2
	exit 1
fi

CONDA_ENVS=${CONDA_ENVS:-/g/data/$PROJECT/$USER/conda}
CONDAENV=microbial_annotations
eval "$(conda shell.bash hook)"
conda activate $CONDA_ENVS/$CONDAENV
plassembler --version

# location of the PLASSEMBLER databases
export PLASSEMBLER_DB=$CONDA_PREFIX/plassembler/

if [[ ! -s "$PLASSEMBLER_DB/plsdb_2023_11_03_v2.msh" ]]; then
	echo "Error: the PLSDB database is not installed in $PLASSEMBLER_DB." >&2
	echo "Run plassembler_install.pbs first." >&2
	exit 1
fi

threads=${PBS_NCPUS:-1}

# --no_chromosome is a flag, not a value, so build the argument list rather than
# trying to pass an empty string (which set -u will not thank you for)
if [[ "$chromosome" == "none" || "$chromosome" == "no_chromosome" ]]; then
	echo "Running in plasmid-only mode (--no_chromosome)" >&2
	chromosome_args=(--no_chromosome)
else
	echo "Expecting a chromosome of at least $chromosome bp" >&2
	chromosome_args=(--chromosome "$chromosome")
fi

TMPDIR=$(mktemp -dp "${PBS_JOBFS:-/scratch/$PROJECT/$USER}")
echo "Temporary files are being written to $TMPDIR" >&2

plassembler long \
	--database "$PLASSEMBLER_DB" \
	--longreads "$reads" \
	--outdir "$TMPDIR/plassembler_out" \
	--threads "$threads" \
	--force \
	--keep_chromosome \
	"${chromosome_args[@]}"

mkdir -p "$output"
rsync -a $TMPDIR/ "$output"
/bin/rm -rf $TMPDIR

echo "=== plasmids ==="
if [[ -s "$output/plassembler_out/plassembler_summary.tsv" ]]; then
	column -t -s $'\t' "$output/plassembler_out/plassembler_summary.tsv"
else
	echo "none"
fi
echo "plassembler results are in $output/plassembler_out"
